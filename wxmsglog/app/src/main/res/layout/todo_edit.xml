<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="4dp">

    <EditText
        android:id="@+id/etTodoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@null"
        android:gravity="top|start"
        android:hint="@string/todo_hint_text"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingExtra="3dp"
        android:maxLines="5"
        android:minLines="2"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/hint"
        android:textSize="15sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="2dp"
        android:background="@color/divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp">

        <TextView
            android:id="@+id/tvTodoDue"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="@string/todo_due_none"
            android:textColor="@color/hint"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnClearDue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:text="@string/todo_due_clear"
            android:textColor="@color/hint"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btnPickDue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:text="@string/todo_due_pick"
            android:textColor="@color/primary"
            android:textSize="13sp" />

    </LinearLayout>

</LinearLayout>
